// MySQL datasource — User Accounts & Bookings (relational, ACID-critical)
generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id           String       @id @default(cuid()) @db.VarChar(36)
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  deleted      Boolean   @default(false)
  deletedAt    DateTime?

  @@map("users")
}

model Booking {
  id        String       @id @default(cuid()) @db.VarChar(36)
  userId    String        @db.VarChar(36)
  user      User          @relation(fields: [userId], references: [id])
  eventId   String
  quantity  Int           @default(1)
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  deleted   Boolean       @default(false)
  deletedAt DateTime?

  @@index([userId])
  @@index([eventId])
  @@map("bookings")
}
