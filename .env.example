# server
PORT=4000
NODE_ENV=development

# cors - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:4000

# mysql (Users, Bookings)
MYSQL_DATABASE_URL="mysql://<USER>:<PASSWORD>@localhost:3306/<DATABASE_NAME>"

# mongodb (Events, System Logs)
MONGODB_DATABASE_URL="mongodb+srv://<USER>:<PASSWORD>@<DOMAIN>.mongodb.net/<DATABASE_NAME>?retryWrites=true&w=majority&appName=<CLUSTER>" # use mongo cloud

# jtw
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
